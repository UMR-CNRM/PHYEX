#-----------------------------------------------------------------------
# Interface modules (MODI_*) generated at build time
#
# The interface module of each source file listed in modi_sources.txt
# (xxx.F90 -> MODI_XXX in modi_xxx.F90) is generated by gen_modi.py in
# ${CMAKE_CURRENT_BINARY_DIR}/modi. When the source code is transformed
# (PHYEX_TRANSFORMATION), the interface is generated from the transformed file.
#
# Usage (in the PHYEX CMakeLists.txt):
#   phyex_generate_modi(<var>)  : once the source list <var> is complete
#                                 (and transformed); the generated files are
#                                 added to <var>
#   phyex_modi_target(<target>) : for each target compiling the generated
#                                 files
#-----------------------------------------------------------------------

ecbuild_find_python(VERSION 3.8 NO_LIBS REQUIRED)

set(PHYEX_MODI_SCRIPT ${CMAKE_CURRENT_LIST_DIR}/gen_modi.py)
set(PHYEX_MODI_LIST ${CMAKE_CURRENT_LIST_DIR}/modi_sources.txt)
set(PHYEX_MODI_DIR ${CMAKE_CURRENT_BINARY_DIR}/modi)

# A modification of the list triggers a new configuration
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${PHYEX_MODI_LIST})

#-----------------------------------------------------------------------
# phyex_generate_modi(<var>)
#-----------------------------------------------------------------------

function(phyex_generate_modi _var)
  file(STRINGS ${PHYEX_MODI_LIST} _modi_sources REGEX "^[^#]")
  file(MAKE_DIRECTORY ${PHYEX_MODI_DIR})
  set(_sources ${${_var}})
  set(_outputs)
  foreach(_rel ${_modi_sources})
    string(STRIP "${_rel}" _rel)
    # Source file actually compiled (transformed or not)
    set(_src)
    foreach(_file ${_sources})
      if(_file MATCHES "/${_rel}$")
        set(_src ${_file})
        break()
      endif()
    endforeach()
    if(NOT _src)
      ecbuild_critical("${_rel} (listed in ${PHYEX_MODI_LIST}) is not a PHYEX source file")
    endif()
    get_filename_component(_name ${_rel} NAME)
    set(_out ${PHYEX_MODI_DIR}/modi_${_name})
    add_custom_command(OUTPUT ${_out}
                       COMMAND ${Python_EXECUTABLE} -I ${PHYEX_MODI_SCRIPT} -o ${PHYEX_MODI_DIR} ${_src}
                       DEPENDS ${_src} ${PHYEX_MODI_SCRIPT}
                       COMMENT "Generating interface module modi_${_name}"
                       VERBATIM)
    list(APPEND _outputs ${_out})
  endforeach()

  # The files are generated by a dedicated target: several targets (dp,
  # sp...) compile the same generated files, they must not generate them
  # concurrently
  add_custom_target(phyex_modi DEPENDS ${_outputs})
  if(PHYEX_TRANSFORM_COMMAND)
    add_dependencies(phyex_modi phyex_transformation)
  endif()
  set(${_var} ${_sources} ${_outputs} PARENT_SCOPE)
  ecbuild_info("Interface modules generated in ${PHYEX_MODI_DIR}")
endfunction()

#-----------------------------------------------------------------------
# phyex_modi_target(<target>)
#-----------------------------------------------------------------------

function(phyex_modi_target _target)
  add_dependencies(${_target} phyex_modi)
endfunction()
